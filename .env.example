# Cloudflare account that will own the deployment
CLOUDFLARE_ACCOUNT_ID=your-account-id

# Optional CA for Docker builds behind Cloudflare WARP
# CLOUDFLARE_ZT_CERT=/path/to/zero_trust_cert.pem

# Browser automation uses the Cloudflare Browser Run binding (BROWSER).
# See docs/browser-sessions.md.

# Optional Access (production deploy)
# ACCESS_EMAIL=you@example.com
# ACCESS_DOMAIN=karishma.<subdomain>.workers.dev
