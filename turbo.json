{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "deploy": {
      "dependsOn": ["^deploy"],
      "cache": false
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "backend#destroy": {
      "cache": false,
      "dependsOn": ["frontend#destroy"]
    },
    "frontend#destroy": {
      "cache": false
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "outputs": ["coverage/**"],
      "dependsOn": []
    },
    "build": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "dependsOn": ["^build"],
      "outputs": [
        "build/**",
        "dist/**",
        "lib/**"
      ]
    }
  }
}
